# Local Docker Compose host ports.
APP_PORT=8000
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://evacuation_user:evacuation_password@localhost:5433/evacuation_db

# Optional database resilience settings. The shown values are also the defaults.
DB_CONNECT_TIMEOUT_SECONDS=10
DB_RETRY_ATTEMPTS=8
DB_RETRY_DELAY_SECONDS=2

# Only needed when a separately hosted frontend must call this backend.
# The combined Railway deployment is same-origin and does not need this setting.
# ALLOWED_ORIGINS=https://example.com

# Backend only. Never prefix this variable with VITE_.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
ASSISTANT_MAX_TOOL_ROUNDS=4
